    from source
)
select
    id,
    source,
    trim(home_team) as home_team,
    trim(away_team) as away_team,
    cast(home_score as integer) as home_score,
    cast(away_score as integer) as away_score,
    game_date,
    ingested_at,
    raw_json
from parsed
  );
  
