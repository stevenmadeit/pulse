  create  table "pulse"."public"."stg_crypto__dbt_tmp"
  
  
    as
  
  (
    with source as (
    select
        id,
        source,
        raw_json,
        ingested_at,
        json_each(raw_json) as coin_entry
    from "pulse"."pulse"."raw_crypto"
)

