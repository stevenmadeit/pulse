        id,
        source,
        raw_json,
        ingested_at,
        events_json -> 0 ->> 'date' as game_date,
        events_json -> 0 -> 'competitions' -> 0 -> 'competitors' -> 0 -> 'team' ->> 'abbreviation' as home_team,
        events_json -> 0 -> 'competitions' -> 0 -> 'competitors' -> 0 ->> 'score' as home_score,
